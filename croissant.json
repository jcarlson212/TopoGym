{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "cr": "http://mlcommons.org/croissant/",
    "sc": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "extract": "cr:extract",
    "field": "cr:field",
    "fileObject": "cr:fileObject",
    "recordSet": "cr:recordSet",
    "source": "cr:source"
  },
  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "TopoGym-v1",
  "description": "The pinned environment registry of TopoGym: gridworld reinforcement-learning environments with certified topology for exploration research. One record per stable environment id, with its canonical generator configuration and the certified Betti numbers (in both door conventions) at the reference seed. Environments are deterministic up to seeds, end to end.",
  "url": "https://github.com/jcarlson212/TopoGym",
  "version": "0.1.0",
  "license": "https://spdx.org/licenses/MIT.html",
  "creator": {
    "@type": "sc:Person",
    "name": "Jason Carlson"
  },
  "citeAs": "@software{carlson2026topogym, author={Carlson, Jason}, title={TopoGym: Environments and Benchmarks for Topological Exploration in Reinforcement Learning}, year={2026}, version={0.1.0}, url={https://github.com/jcarlson212/TopoGym}}",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "manifest.csv",
      "name": "manifest.csv",
      "description": "One record per pinned environment id.",
      "contentUrl": "https://raw.githubusercontent.com/jcarlson212/TopoGym/main/docs/manifest.csv",
      "encodingFormat": "text/csv",
      "sha256": "8692fe99da1398f8a2952cfb4f4fde93f59fe2a1a45fa9875f64b46c6a50a681"
    },
    {
      "@type": "cr:FileObject",
      "@id": "repository",
      "name": "repository",
      "description": "The TopoGym source: pip install topogym; import topogym registers every id below.",
      "contentUrl": "https://github.com/jcarlson212/TopoGym",
      "encodingFormat": "git+https",
      "sha256": "main"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "environments",
      "name": "environments",
      "description": "The TopoGym-v1 registry: every stable environment id with certified topology.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "environments/env_id",
          "name": "env_id",
          "description": "Stable Gymnasium id, e.g. TopoGym/Decoys4-50-v0.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "env_id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/slice",
          "name": "slice",
          "description": "GridWorld2D, Top, or Texture.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "slice"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/family",
          "name": "family",
          "description": "Environment family.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "family"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/canonical_config",
          "name": "canonical_config",
          "description": "Canonical configuration string (run-log key).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "canonical_config"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/reference_seed",
          "name": "reference_seed",
          "description": "Seed used for the certified values below; any seed regenerates deterministically.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "reference_seed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/size",
          "name": "size",
          "description": "Grid side length.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "size"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/horizon",
          "name": "horizon",
          "description": "Pre-determined episode length.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "horizon"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/n_cells",
          "name": "n_cells",
          "description": "Total cells.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "n_cells"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/n_free_cells",
          "name": "n_free_cells",
          "description": "Traversable cells.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "n_free_cells"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/betti_z2",
          "name": "betti_z2",
          "description": "Certified Betti numbers (doors walkable).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "betti_z2"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/betti_z2_sealed",
          "name": "betti_z2_sealed",
          "description": "Certified Betti numbers (doors count as walls).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "betti_z2_sealed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "environments/homology",
          "name": "homology",
          "description": "Integral homology groups H0/H1/H2.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "manifest.csv"
            },
            "extract": {
              "column": "homology"
            }
          }
        }
      ]
    }
  ]
}
